rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        request.auth.token.email == 'ammarrmnk@gmail.com'
      );
    }

    function isOrganizer() {
      return isAuthenticated() && (
        isAdmin() ||
        request.auth.token.role == 'organizer'
      );
    }

    // Admins have full read/write access to all collections
    match /{document=**} {
      allow read, write: if isAdmin();
    }

    // Events rules
    match /events/{eventId} {
      allow read: if true; // Public can view published events
      allow create: if isOrganizer();
      allow update, delete: if isAdmin();
    }

    // Organizers rules
    match /organizers/{organizerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Registrations rules
    match /registrations/{regId} {
      allow read, write: if isAdmin();
      allow create: if isAuthenticated();
    }

    // Users rules
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || (isAuthenticated() && request.auth.uid == userId);
    }
  }
}
