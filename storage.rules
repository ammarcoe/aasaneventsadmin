rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        request.auth.token.email == 'ammarrmnk@gmail.com'
      );
    }

    // Public read for event banners and organizer avatars
    match /{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
